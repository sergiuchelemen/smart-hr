# Copiază în .env și înlocuiește placeholderele. NU comite .env.
POSTGRES_DB=CHANGE_ME_db
POSTGRES_USER=CHANGE_ME_user
POSTGRES_PASSWORD=CHANGE_ME_password
# Opțional: port host (implicit 5432 / 27017)
# POSTGRES_PORT=5432
# MONGO_PORT=27017
MONGO_USER=CHANGE_ME_user
MONGO_PASSWORD=CHANGE_ME_password
MONGO_DB=CHANGE_ME_db
# Minim 32 de octeți, generat random (ex: openssl rand -base64 48)
JWT_SECRET=CHANGE_ME_min_32_bytes_random_secret
PLATFORM_ADMIN_EMAIL=CHANGE_ME_admin@example.com
PLATFORM_ADMIN_PASSWORD=CHANGE_ME_strong_password
